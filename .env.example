# Copy to .env and adjust if needed. No API keys are required: all sources are public.

# PostgreSQL (warehouse + Airflow metadata live in the same container, separate databases)
POSTGRES_USER=findata
POSTGRES_PASSWORD=findata
POSTGRES_PORT=5432

# Host ports
AIRFLOW_PORT=8080
DASHBOARD_PORT=8501

# First date loaded on an empty warehouse
FINDATA_START_DATE=2015-01-01
